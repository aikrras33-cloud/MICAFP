{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "..",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["chrome"],
    "allowJs": false,
    "resolveJsonModule": true
  },
  "include": [
    "*.ts",
    "background/**/*.ts",
    "content/**/*.ts",
    "options/**/*.ts",
    "popup/**/*.ts",
    "../shared/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "src"]
}